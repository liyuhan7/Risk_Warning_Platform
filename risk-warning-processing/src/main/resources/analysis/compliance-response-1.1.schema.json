{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compliance model response 1.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "indicatorId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "enterpriseFact": {
      "type": "string",
      "minLength": 1
    },
    "reasoning": {
      "type": "string",
      "minLength": 1
    },
    "requirement": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "gapUnit": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "observedUnit": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "gapValue": {
      "type": [
        "number",
        "null"
      ]
    },
    "observedValue": {
      "type": [
        "number",
        "null"
      ]
    },
    "schemaVersion": {
      "const": "1.1"
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "regulationIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "applicable": {
      "enum": [
        "APPLICABLE",
        "NOT_APPLICABLE",
        "UNKNOWN"
      ]
    },
    "complianceStatus": {
      "enum": [
        "COMPLIANT",
        "NON_COMPLIANT",
        "INSUFFICIENT_EVIDENCE",
        "NEEDS_REVIEW",
        "NO_APPLICABLE_CANDIDATE"
      ]
    },
    "gapType": {
      "enum": [
        null,
        "MISSING_ACTION",
        "PROHIBITED_ACTION",
        "QUANTITATIVE_SHORTFALL",
        "QUANTITATIVE_EXCESS",
        "DOCUMENTATION_GAP"
      ]
    },
    "conditionMet": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "indicatorId",
    "enterpriseFact",
    "reasoning",
    "schemaVersion",
    "evidenceIds",
    "applicable",
    "complianceStatus",
    "confidence",
    "regulationIds"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "applicable"
        ],
        "properties": {
          "applicable": {
            "const": "UNKNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "complianceStatus": {
            "enum": [
              "INSUFFICIENT_EVIDENCE",
              "NEEDS_REVIEW"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "complianceStatus"
        ],
        "properties": {
          "complianceStatus": {
            "const": "NON_COMPLIANT"
          }
        }
      },
      "then": {
        "required": [
          "gapType"
        ],
        "properties": {
          "gapType": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "gapValue"
        ],
        "properties": {
          "gapValue": {
            "type": "number"
          }
        }
      },
      "then": {
        "required": [
          "gapUnit"
        ],
        "properties": {
          "gapUnit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "observedValue"
        ],
        "properties": {
          "observedValue": {
            "type": "number"
          }
        }
      },
      "then": {
        "required": [
          "observedUnit"
        ],
        "properties": {
          "observedUnit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "observedUnit"
        ],
        "properties": {
          "observedUnit": {
            "type": "string"
          }
        }
      },
      "then": {
        "required": [
          "observedValue"
        ],
        "properties": {
          "observedValue": {
            "type": "number"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "conditionMet"
        ],
        "properties": {
          "conditionMet": {
            "type": "boolean"
          }
        }
      },
      "then": {
        "properties": {
          "observedValue": {
            "type": "null"
          },
          "observedUnit": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "indicatorId"
        ],
        "properties": {
          "indicatorId": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "applicable": {
            "const": "NOT_APPLICABLE"
          },
          "complianceStatus": {
            "const": "NO_APPLICABLE_CANDIDATE"
          }
        }
      },
      "else": {
        "properties": {
          "complianceStatus": {
            "enum": [
              "COMPLIANT",
              "NON_COMPLIANT",
              "INSUFFICIENT_EVIDENCE",
              "NEEDS_REVIEW"
            ]
          }
        }
      }
    }
  ]
}
